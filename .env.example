# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kiranamart247?schema=public"

# Authentication
AUTH_SECRET="replace-with-a-random-32-character-secret-key"

# Gmail / Email SMTP OTP Configuration (for instant Registration OTP)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-gmail-app-password"

# AI Assistant
OPENAI_API_KEY=""

# ==============================================================================
# Razorpay Payment Gateway Credentials (Test/Live Mode)
# ==============================================================================
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# ==============================================================================
# Meta WhatsApp Business Platform / Cloud API Credentials
# ==============================================================================
# 1. Phone Number ID from Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"

# 2. WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_waba_id"

# 3. Permanent System User Access Token generated from Meta Business Manager
WHATSAPP_ACCESS_TOKEN="EAA..."

# 4. Webhook Verification Token (set this same secret in Meta Webhook configuration)
WHATSAPP_VERIFY_TOKEN="kiranamart_whatsapp_verify_token_2026"

# 5. Meta App Secret for validating incoming webhook HMAC-SHA256 signatures (App Settings -> Basic)
WHATSAPP_APP_SECRET="your_meta_app_secret"

# 6. Meta Graph API Version (defaults to v21.0)
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_BASE_URL="https://graph.facebook.com"

# Customer Support WhatsApp Number (E.164 digits without + e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER="919876543210"
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/919876543210"

# Social Media Links (Public website footer)
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com"
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com"

# ==============================================================================
# Official AI Social Media Auto-Publish OAuth & API Credentials
# ==============================================================================
# Meta Graph API v20.0 (Instagram Business & Facebook Page)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_REDIRECT_URI="https://kiranamart247.com/api/admin/social/oauth/meta/callback"

# Google Cloud OAuth 2.0 (YouTube Data API v3)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://kiranamart247.com/api/admin/social/oauth/youtube/callback"

